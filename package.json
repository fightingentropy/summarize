{
  "name": "summarize",
  "version": "0.14.1",
  "description": "Link → clean text → summary.",
  "bin": {
    "summarize": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./content": {
      "types": "./dist/types/content/index.d.ts",
      "import": "./dist/esm/content/index.js"
    },
    "./content/url": {
      "types": "./dist/types/content/url.d.ts",
      "import": "./dist/esm/content/url.js"
    },
    "./language": {
      "types": "./dist/types/language.d.ts",
      "import": "./dist/esm/language.js"
    },
    "./processes": {
      "types": "./dist/types/processes.d.ts",
      "import": "./dist/esm/processes.js"
    },
    "./prompts": {
      "types": "./dist/types/prompts/index.d.ts",
      "import": "./dist/esm/prompts/index.js"
    }
  },
  "scripts": {
    "build": "bun run clean && bun run build:lib && bun run build:cli",
    "build:bun": "bun scripts/build-bun.js",
    "build:bun:test": "bun scripts/build-bun.js --test",
    "build:cli": "node scripts/build-cli.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run perf:guard && bun run test:coverage",
    "clean": "rimraf dist",
    "docs:list": "tsx scripts/docs-list.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --tsconfig tsconfig.build.json --config .oxlintrc.json .",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.build.json --config .oxlintrc.json --fix . && bun run format",
    "perf:guard": "tsx scripts/guard-extraction-perf.ts",
    "prepare": "bun run build",
    "profile:extract": "tsx scripts/profile-extraction.ts",
    "release": "bash scripts/release.sh",
    "s": "tsx src/cli.ts",
    "summarize": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:build": "bun run build && bun run test:coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.4",
    "@mariozechner/pi-ai": "^0.57.1",
    "@mozilla/readability": "0.6.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "es-toolkit": "^1.45.1",
    "file-type": "^21.3.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "28.1.0",
    "json5": "^2.2.3",
    "markdansi": "^0.2.1",
    "mime": "^4.1.0",
    "ora": "^9.3.0",
    "osc-progress": "^0.3.0",
    "sanitize-html": "^2.17.1",
    "tokentally": "^0.1.1",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.3.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "oxfmt": "0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "7.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.9"
}
